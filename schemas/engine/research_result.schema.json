{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tuppi/schemas/engine/research_result.schema.json",
  "title": "project_target_v1 full research-private run result",
  "description": "Canonical full-information output. This artifact contains all initial hands and must never be passed to an agent or treated as a public log.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset_id",
    "visibility",
    "contains_hidden_information",
    "execution_status",
    "match_input_id",
    "match_ref",
    "initial_score",
    "initial_dealer",
    "agent_ids",
    "deals",
    "final_score",
    "next_dealer",
    "terminal",
    "match_result",
    "event_log_id",
    "public_events"
  ],
  "properties": {
    "schema_version": {"const": "tuppi.engine.research_result.v1"},
    "ruleset_id": {"const": "project_target_v1"},
    "visibility": {"const": "research_private"},
    "contains_hidden_information": {"const": true},
    "execution_status": {"const": "success"},
    "match_input_id": {"$ref": "#/$defs/sha256"},
    "match_ref": {"$ref": "#/$defs/matchRef"},
    "initial_score": {"$ref": "#/$defs/nonterminalScore"},
    "initial_dealer": {"$ref": "#/$defs/seat"},
    "agent_ids": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "string", "minLength": 1},
        {"type": "string", "minLength": 1},
        {"type": "string", "minLength": 1},
        {"type": "string", "minLength": 1}
      ],
      "items": false
    },
    "deals": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/researchDealResult"}
    },
    "final_score": {"$ref": "#/$defs/score"},
    "next_dealer": {
      "oneOf": [{"$ref": "#/$defs/seat"}, {"type": "null"}]
    },
    "terminal": {"type": "boolean"},
    "match_result": {
      "oneOf": [
        {
          "$ref": "https://example.invalid/tuppi/schemas/engine/match_result.schema.json"
        },
        {"type": "null"}
      ]
    },
    "event_log_id": {"$ref": "#/$defs/sha256"},
    "public_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://example.invalid/tuppi/schemas/engine/public_event_log.schema.json#/$defs/event"
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"terminal": {"const": true}}, "required": ["terminal"]},
      "then": {
        "properties": {
          "final_score": {"$ref": "#/$defs/terminalScore"},
          "next_dealer": {"type": "null"},
          "match_result": {
            "$ref": "https://example.invalid/tuppi/schemas/engine/match_result.schema.json"
          }
        }
      },
      "else": {
        "properties": {
          "final_score": {"$ref": "#/$defs/nonterminalScore"},
          "next_dealer": {"$ref": "#/$defs/seat"},
          "match_result": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "seat": {"type": "integer", "minimum": 0, "maximum": 3},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "matchRef": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,96}$"},
    "card": {"type": "string", "pattern": "^(?:[2-9]|10|J|Q|K|A)[HDCS]$"},
    "hand": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/card"}
    },
    "hands": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/hand"},
        {"$ref": "#/$defs/hand"},
        {"$ref": "#/$defs/hand"},
        {"$ref": "#/$defs/hand"}
      ],
      "items": false
    },
    "score": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [{"const": 0}, {"type": "integer", "minimum": 0}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 1}, {"const": 0}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "nonterminalScore": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [{"const": 0}, {"type": "integer", "minimum": 0, "maximum": 51}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 1, "maximum": 51}, {"const": 0}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "terminalScore": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [{"const": 0}, {"type": "integer", "minimum": 52}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 52}, {"const": 0}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "researchDealResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deal_id", "initial_hands", "public_result"],
      "properties": {
        "deal_id": {"$ref": "#/$defs/sha256"},
        "initial_hands": {"$ref": "#/$defs/hands"},
        "public_result": {
          "$ref": "https://example.invalid/tuppi/schemas/engine/deal_result.schema.json"
        }
      }
    }
  },
  "$comment": "This schema marks the private boundary explicitly. The engine additionally verifies global hand uniqueness, each deal_id, match_input_id, equality of private/public deal metadata, event aggregation/digest, score continuity, final dealer, and match-result equality."
}
