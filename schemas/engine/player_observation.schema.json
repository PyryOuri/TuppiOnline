{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tuppi/schemas/engine/player_observation.schema.json",
  "title": "project_target_v1/v2/v3 player-private observation",
  "description": "A serialized immutable observation for one seat. This is not a public event artifact or an accepted state input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset_id",
    "visibility",
    "match_ref",
    "deal_ref",
    "observing_seat",
    "team",
    "partner_seat",
    "dealer",
    "forehand",
    "phase",
    "current_actor",
    "own_hand",
    "show_actions",
    "publicly_shown_cards",
    "contract",
    "declarer",
    "first_leader",
    "completed_tricks",
    "current_trick",
    "team_tricks",
    "match_score",
    "legal_actions",
    "deal_terminal",
    "match_terminal"
  ],
  "properties": {
    "schema_version": {
      "const": "tuppi.engine.player_observation.v1"
    },
    "ruleset_id": {
      "enum": [
        "project_target_v1",
        "project_target_v2",
        "project_target_v3"
      ]
    },
    "visibility": {
      "const": "player_private"
    },
    "match_ref": {
      "$ref": "#/$defs/matchRef"
    },
    "deal_ref": {
      "$ref": "#/$defs/dealRef"
    },
    "observing_seat": {
      "$ref": "#/$defs/seat"
    },
    "team": {
      "$ref": "#/$defs/team"
    },
    "partner_seat": {
      "$ref": "#/$defs/seat"
    },
    "dealer": {
      "$ref": "#/$defs/seat"
    },
    "forehand": {
      "$ref": "#/$defs/seat"
    },
    "phase": {
      "enum": [
        "SHOWING",
        "TRICK_PLAY",
        "DEAL_COMPLETE",
        "MATCH_COMPLETE",
        "SOOLI_OFFER",
        "SOOLI_GIVE",
        "SOOLI_RETURN",
        "SOOLI_PLAY"
      ]
    },
    "current_actor": {
      "oneOf": [
        {
          "$ref": "#/$defs/seat"
        },
        {
          "type": "null"
        }
      ]
    },
    "own_hand": {
      "type": "array",
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "show_actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/acceptedShow"
      },
      "$comment": "Empty during showing under project_target_v3 (locked bids)."
    },
    "publicly_shown_cards": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/publicShownCard"
      }
    },
    "contract": {
      "oneOf": [
        {
          "enum": [
            "RAMI",
            "NOLO"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "declarer": {
      "oneOf": [
        {
          "$ref": "#/$defs/seat"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_leader": {
      "oneOf": [
        {
          "$ref": "#/$defs/seat"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_tricks": {
      "type": "array",
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/completedTrick"
      }
    },
    "current_trick": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/playedCard"
      }
    },
    "team_tricks": {
      "$ref": "#/$defs/teamTricks"
    },
    "match_score": {
      "$ref": "#/$defs/score"
    },
    "legal_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "deal_terminal": {
      "type": "boolean"
    },
    "match_terminal": {
      "type": "boolean"
    },
    "sooli": {
      "$ref": "#/$defs/sooliObservation"
    },
    "bids_locked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ruleset_id": {
            "const": "project_target_v1"
          }
        },
        "required": [
          "ruleset_id"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "sooli"
              ]
            },
            {
              "required": [
                "bids_locked"
              ]
            }
          ]
        },
        "properties": {
          "phase": {
            "enum": [
              "SHOWING",
              "TRICK_PLAY",
              "DEAL_COMPLETE",
              "MATCH_COMPLETE"
            ]
          },
          "own_hand": {
            "maxItems": 13
          },
          "completed_tricks": {
            "items": {
              "properties": {
                "plays": {
                  "minItems": 4
                }
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "sooli"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ruleset_id": {
            "const": "project_target_v3"
          }
        },
        "required": [
          "ruleset_id"
        ]
      },
      "then": {
        "required": [
          "bids_locked"
        ]
      },
      "else": {
        "not": {
          "required": [
            "bids_locked"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "ruleset_id": {
            "const": "project_target_v3"
          },
          "phase": {
            "const": "SHOWING"
          }
        },
        "required": [
          "ruleset_id",
          "phase"
        ]
      },
      "then": {
        "properties": {
          "show_actions": {
            "maxItems": 0
          },
          "publicly_shown_cards": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "bids_locked": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sooli": {
            "properties": {
              "exchanged": {
                "const": true
              }
            },
            "required": [
              "exchanged"
            ]
          }
        },
        "required": [
          "sooli"
        ]
      },
      "then": {
        "properties": {
          "completed_tricks": {
            "items": {
              "properties": {
                "plays": {
                  "maxItems": 3
                }
              }
            }
          },
          "current_trick": {
            "maxItems": 2
          }
        }
      },
      "else": {
        "properties": {
          "completed_tricks": {
            "items": {
              "properties": {
                "plays": {
                  "minItems": 4
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "phase": {
                "const": "DEAL_COMPLETE"
              }
            },
            "required": [
              "phase"
            ]
          },
          {
            "not": {
              "properties": {
                "sooli": {
                  "properties": {
                    "exchanged": {
                      "const": true
                    }
                  },
                  "required": [
                    "exchanged"
                  ]
                }
              },
              "required": [
                "sooli"
              ]
            }
          }
        ]
      },
      "then": {
        "properties": {
          "completed_tricks": {
            "minItems": 13
          },
          "own_hand": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "phase": {
                "const": "MATCH_COMPLETE"
              }
            },
            "required": [
              "phase"
            ]
          },
          {
            "not": {
              "properties": {
                "sooli": {
                  "properties": {
                    "exchanged": {
                      "const": true
                    }
                  },
                  "required": [
                    "exchanged"
                  ]
                }
              },
              "required": [
                "sooli"
              ]
            }
          }
        ]
      },
      "then": {
        "properties": {
          "completed_tricks": {
            "minItems": 13
          },
          "own_hand": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "SHOWING"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "contract": {
            "type": "null"
          },
          "declarer": {
            "type": "null"
          },
          "first_leader": {
            "type": "null"
          },
          "completed_tricks": {
            "maxItems": 0
          },
          "current_trick": {
            "maxItems": 0
          },
          "team_tricks": {
            "const": [
              0,
              0
            ]
          },
          "deal_terminal": {
            "const": false
          },
          "match_terminal": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "TRICK_PLAY"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "contract": {
            "enum": [
              "RAMI",
              "NOLO"
            ]
          },
          "first_leader": {
            "$ref": "#/$defs/seat"
          },
          "completed_tricks": {
            "maxItems": 12
          },
          "deal_terminal": {
            "const": false
          },
          "match_terminal": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "DEAL_COMPLETE"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "current_actor": {
            "type": "null"
          },
          "completed_tricks": {
            "minItems": 1,
            "maxItems": 13
          },
          "current_trick": {
            "maxItems": 0
          },
          "legal_actions": {
            "maxItems": 0
          },
          "deal_terminal": {
            "const": true
          },
          "match_terminal": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "MATCH_COMPLETE"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "current_actor": {
            "type": "null"
          },
          "completed_tricks": {
            "minItems": 1,
            "maxItems": 13
          },
          "current_trick": {
            "maxItems": 0
          },
          "legal_actions": {
            "maxItems": 0
          },
          "deal_terminal": {
            "const": true
          },
          "match_terminal": {
            "const": true
          },
          "match_score": {
            "$ref": "#/$defs/terminalScore"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "const": "RAMI"
          }
        },
        "required": [
          "contract"
        ]
      },
      "then": {
        "properties": {
          "declarer": {
            "$ref": "#/$defs/seat"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "const": "NOLO"
          }
        },
        "required": [
          "contract"
        ]
      },
      "then": {
        "properties": {
          "declarer": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "SOOLI_OFFER",
              "SOOLI_GIVE",
              "SOOLI_RETURN",
              "SOOLI_PLAY"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "contract": {
            "const": "RAMI"
          },
          "declarer": {
            "$ref": "#/$defs/seat"
          },
          "first_leader": {
            "$ref": "#/$defs/seat"
          },
          "deal_terminal": {
            "const": false
          },
          "match_terminal": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "seat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "team": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "matchRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "dealRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}/deal:(?:0|[1-9][0-9]*)$",
      "maxLength": 128
    },
    "card": {
      "type": "string",
      "pattern": "^(?:[2-9]|10|J|Q|K|A)[HDCS]$"
    },
    "score": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "terminalScore": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 52
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 52
            },
            {
              "const": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "teamTricks": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "playedCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seat",
        "card"
      ],
      "properties": {
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "card": {
          "$ref": "#/$defs/card"
        }
      }
    },
    "acceptedShow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seat",
        "shown_card",
        "declared_contract",
        "verbal_required"
      ],
      "properties": {
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "shown_card": {
          "$ref": "#/$defs/card"
        },
        "declared_contract": {
          "enum": [
            "RAMI",
            "NOLO"
          ]
        },
        "verbal_required": {
          "type": "boolean"
        }
      }
    },
    "publicShownCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seat",
        "card"
      ],
      "properties": {
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "card": {
          "$ref": "#/$defs/card"
        }
      }
    },
    "completedTrick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trick_index",
        "leader",
        "plays",
        "winner"
      ],
      "properties": {
        "trick_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "leader": {
          "$ref": "#/$defs/seat"
        },
        "plays": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/playedCard"
          }
        },
        "winner": {
          "$ref": "#/$defs/seat"
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/showAction"
        },
        {
          "$ref": "#/$defs/playAction"
        },
        {
          "$ref": "#/$defs/sooliDecisionAction"
        },
        {
          "$ref": "#/$defs/sooliExchangeAction"
        }
      ]
    },
    "showAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "seat",
        "shown_card",
        "declared_contract"
      ],
      "properties": {
        "type": {
          "const": "show"
        },
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "shown_card": {
          "$ref": "#/$defs/card"
        },
        "declared_contract": {
          "enum": [
            "RAMI",
            "NOLO"
          ]
        }
      }
    },
    "playAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "seat",
        "card"
      ],
      "properties": {
        "type": {
          "const": "play"
        },
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "card": {
          "$ref": "#/$defs/card"
        }
      }
    },
    "sooliObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisions",
        "soolaaja",
        "partner",
        "exchanged",
        "given_card",
        "returned_card"
      ],
      "properties": {
        "decisions": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seat",
              "play_sooli"
            ],
            "properties": {
              "seat": {
                "$ref": "#/$defs/seat"
              },
              "play_sooli": {
                "type": "boolean"
              }
            }
          }
        },
        "soolaaja": {
          "oneOf": [
            {
              "$ref": "#/$defs/seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "partner": {
          "oneOf": [
            {
              "$ref": "#/$defs/seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "exchanged": {
          "type": "boolean"
        },
        "given_card": {
          "oneOf": [
            {
              "$ref": "#/$defs/card"
            },
            {
              "type": "null"
            }
          ]
        },
        "returned_card": {
          "oneOf": [
            {
              "$ref": "#/$defs/card"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "$comment": "given_card and returned_card are non-null only for the soolaaja and the partner."
    },
    "sooliDecisionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "seat",
        "play_sooli"
      ],
      "properties": {
        "type": {
          "const": "sooli_decision"
        },
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "play_sooli": {
          "type": "boolean"
        }
      }
    },
    "sooliExchangeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "seat",
        "card"
      ],
      "properties": {
        "type": {
          "const": "sooli_exchange"
        },
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "card": {
          "$ref": "#/$defs/card"
        }
      }
    }
  },
  "$comment": "Schema validation alone cannot prove observation privacy, seat/team/partner relations, shown-card duplication, legal-action correctness, trick totals, or equality of public show views. Those are derived from validated private state and tested adversarially."
}
