{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tuppi/schemas/engine/match_input.schema.json",
  "title": "project_target_v1 explicit match input",
  "description": "A nonempty finite sequence of fully materialized explicit deals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset_id",
    "match_input_id",
    "match_ref",
    "initial_score",
    "initial_dealer",
    "deals"
  ],
  "properties": {
    "schema_version": {"const": "tuppi.engine.match_input.v1"},
    "ruleset_id": {"const": "project_target_v1"},
    "match_input_id": {"$ref": "#/$defs/sha256"},
    "match_ref": {"$ref": "#/$defs/matchRef"},
    "initial_score": {"$ref": "#/$defs/nonterminalScore"},
    "initial_dealer": {"$ref": "#/$defs/seat"},
    "deals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://example.invalid/tuppi/schemas/engine/explicit_deal.schema.json"
      }
    }
  },
  "$defs": {
    "seat": {"type": "integer", "minimum": 0, "maximum": 3},
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "matchRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "nonterminalScore": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {"const": 0},
            {"type": "integer", "minimum": 0, "maximum": 51}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1, "maximum": 51},
            {"const": 0}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    }
  },
  "$comment": "Dealer rotation across deals and match_input_id recomputation are enforced by ExplicitMatchInput."
}
