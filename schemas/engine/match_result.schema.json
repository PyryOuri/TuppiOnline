{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tuppi/schemas/engine/match_result.schema.json",
  "title": "project_target_v1/v2/v3 terminal match result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset_id",
    "match_ref",
    "initial_score",
    "initial_dealer",
    "final_score",
    "winner_team",
    "deals",
    "event_log_id",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "tuppi.engine.match_result.v1"
    },
    "ruleset_id": {
      "enum": [
        "project_target_v1",
        "project_target_v2",
        "project_target_v3"
      ]
    },
    "match_ref": {
      "$ref": "#/$defs/matchRef"
    },
    "initial_score": {
      "$ref": "#/$defs/nonterminalScore"
    },
    "initial_dealer": {
      "$ref": "#/$defs/seat"
    },
    "final_score": {
      "$ref": "#/$defs/terminalScore"
    },
    "winner_team": {
      "$ref": "#/$defs/team"
    },
    "deals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://example.invalid/tuppi/schemas/engine/deal_result.schema.json"
      }
    },
    "event_log_id": {
      "$ref": "#/$defs/sha256"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://example.invalid/tuppi/schemas/engine/public_event_log.schema.json#/$defs/event"
      }
    }
  },
  "$defs": {
    "seat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "team": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "matchRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "nonterminalScore": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 51
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 51
            },
            {
              "const": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "terminalScore": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 52
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 52
            },
            {
              "const": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    }
  },
  "$comment": "The engine enforces winner/score agreement, deal continuity, terminal final deal, global event equality and contiguous indices, and event_log_id recomputation."
}
