{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tuppi/schemas/evaluation/promotion_decision.schema.json",
  "title": "Future champion-promotion decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "candidate_team_id", "champion_team_id",
    "evaluation_result_ids", "primary_metric", "confidence_interval",
    "historical_agent_results", "contract_regressions", "score_state_regressions",
    "failure_rate", "latency_budget_seconds", "reproducible", "outcome", "rationale"
  ],
  "properties": {
    "schema_version": {"const": "tuppi.eval.promotion_decision.v1"},
    "decision_id": {"type": "string", "pattern": "^promotion:sha256:[0-9a-f]{64}$"},
    "candidate_team_id": {"$ref": "#/$defs/teamId"},
    "champion_team_id": {"$ref": "#/$defs/teamId"},
    "evaluation_result_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^result:sha256:[0-9a-f]{64}$"}},
    "primary_metric": {"type": "string", "minLength": 1},
    "confidence_interval": {
      "oneOf": [
        {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        {"type": "null"}
      ]
    },
    "historical_agent_results": {"type": "object"},
    "contract_regressions": {"type": "object"},
    "score_state_regressions": {"type": "object"},
    "failure_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "latency_budget_seconds": {"type": "number", "exclusiveMinimum": 0},
    "reproducible": {"type": "boolean"},
    "outcome": {"enum": ["promoted", "rejected", "inconclusive", "invalid_run"]},
    "rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "teamId": {"type": "string", "pattern": "^team:sha256:[0-9a-f]{64}$"}
  },
  "$comment": "Phase 3 exercises this schema only with non-strategic baselines and makes no champion-strength claim."
}
