{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tuppi/schemas/evaluation/schedule.schema.json",
  "title": "Balanced duplicate Tuppi schedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schedule_id", "design_id", "mode", "deal_bank_id",
    "team_a_id", "team_b_id", "block_size", "transformations", "entries"
  ],
  "properties": {
    "schema_version": {"const": "tuppi.eval.schedule.v1"},
    "schedule_id": {"type": "string", "pattern": "^schedule:sha256:[0-9a-f]{64}$"},
    "design_id": {"const": "balanced_duplicate_8_v1"},
    "mode": {"enum": ["deal", "match"]},
    "deal_bank_id": {"type": "string", "pattern": "^bank:sha256:[0-9a-f]{64}$"},
    "team_a_id": {"$ref": "#/$defs/teamId"},
    "team_b_id": {"$ref": "#/$defs/teamId"},
    "block_size": {"const": 8},
    "transformations": {
      "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
      "items": {"$ref": "#/$defs/transformation"}
    },
    "entries": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "seat": {"type": "integer", "minimum": 0, "maximum": 3},
    "teamId": {"type": "string", "pattern": "^team:sha256:[0-9a-f]{64}$"},
    "agentId": {"type": "string", "pattern": "^agent:sha256:[0-9a-f]{64}$"},
    "fourTeams": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/teamId"}},
    "fourAgents": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/agentId"}},
    "transformation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "transformation_id", "label", "seat_rotation", "team_assignment_exchange", "partner_seat_exchange", "suit_permutation", "strength_estimation"],
      "properties": {
        "schema_version": {"const": "tuppi.eval.transformation.v1"},
        "transformation_id": {"type": "string", "pattern": "^transform:sha256:[0-9a-f]{64}$"},
        "label": {"type": "string", "minLength": 1},
        "seat_rotation": {"$ref": "#/$defs/seat"},
        "team_assignment_exchange": {"type": "boolean"},
        "partner_seat_exchange": {"type": "boolean"},
        "suit_permutation": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["hearts", "diamonds", "clubs", "spades"]}
        },
        "strength_estimation": {"type": "boolean"}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "entry_id", "schedule_position", "block_index",
        "base_deal_index", "base_deal_id", "source_base_deal_indices",
        "source_base_deal_ids", "transformation", "transformation_id",
        "transformed_deal_id", "transformed_deal_ids", "transformed_dealer",
        "transformed_forehand", "seat_team_ids", "seat_agent_ids",
        "seat_external_teams"
      ],
      "properties": {
        "schema_version": {"const": "tuppi.eval.schedule_entry.v1"},
        "entry_id": {"type": "string", "pattern": "^entry:sha256:[0-9a-f]{64}$"},
        "schedule_position": {"type": "integer", "minimum": 0},
        "block_index": {"type": "integer", "minimum": 0},
        "base_deal_index": {"type": "integer", "minimum": 0},
        "base_deal_id": {"type": "string", "pattern": "^(?:base|sequence):sha256:[0-9a-f]{64}$"},
        "source_base_deal_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "source_base_deal_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^base:sha256:[0-9a-f]{64}$"}},
        "transformation": {"$ref": "#/$defs/transformation"},
        "transformation_id": {"type": "string", "pattern": "^transform:sha256:[0-9a-f]{64}$"},
        "transformed_deal_id": {"type": "string", "pattern": "^(?:concrete|concrete-sequence):sha256:[0-9a-f]{64}$"},
        "transformed_deal_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^concrete:sha256:[0-9a-f]{64}$"}},
        "transformed_dealer": {"$ref": "#/$defs/seat"},
        "transformed_forehand": {"$ref": "#/$defs/seat"},
        "seat_team_ids": {"$ref": "#/$defs/fourTeams"},
        "seat_agent_ids": {"$ref": "#/$defs/fourAgents"},
        "seat_external_teams": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"enum": ["A", "B"]}
        }
      }
    }
  },
  "$comment": "Executable validation proves eight-row balance and exact schedule identity."
}
