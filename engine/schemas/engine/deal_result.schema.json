{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tuppi/schemas/engine/deal_result.schema.json",
  "title": "project_target_v1/v2/v3 completed public deal result",
  "description": "A completed public result: 13 four-card tricks, or for a sooli deal 1 to 13 three-card tricks. Initial hidden hands and exchanged cards are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset_id",
    "match_ref",
    "deal_ref",
    "deal_number",
    "dealer",
    "forehand",
    "contract",
    "declarer",
    "first_leader",
    "show_actions",
    "tricks",
    "team_tricks",
    "deal_score",
    "outcome",
    "score_before",
    "score_after",
    "match_terminal",
    "next_dealer",
    "event_log_id",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "tuppi.engine.deal_result.v1"
    },
    "ruleset_id": {
      "enum": [
        "project_target_v1",
        "project_target_v2",
        "project_target_v3"
      ]
    },
    "match_ref": {
      "$ref": "#/$defs/matchRef"
    },
    "deal_ref": {
      "$ref": "#/$defs/dealRef"
    },
    "deal_number": {
      "type": "integer",
      "minimum": 0
    },
    "dealer": {
      "$ref": "#/$defs/seat"
    },
    "forehand": {
      "$ref": "#/$defs/seat"
    },
    "contract": {
      "enum": [
        "RAMI",
        "NOLO"
      ]
    },
    "declarer": {
      "oneOf": [
        {
          "$ref": "#/$defs/seat"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_leader": {
      "$ref": "#/$defs/seat"
    },
    "show_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/acceptedShow"
      }
    },
    "tricks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/completedTrick"
      }
    },
    "team_tricks": {
      "$ref": "#/$defs/teamTricks"
    },
    "deal_score": {
      "$ref": "#/$defs/dealScore"
    },
    "outcome": {
      "enum": [
        "NOLO",
        "MADE_RAMI",
        "STOLEN_RAMI",
        "SOOLI_WON",
        "SOOLI_LOST"
      ]
    },
    "score_before": {
      "$ref": "#/$defs/nonterminalScore"
    },
    "score_after": {
      "$ref": "#/$defs/score"
    },
    "match_terminal": {
      "type": "boolean"
    },
    "next_dealer": {
      "oneOf": [
        {
          "$ref": "#/$defs/seat"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_log_id": {
      "$ref": "#/$defs/sha256"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://example.invalid/tuppi/schemas/engine/public_event_log.schema.json#/$defs/event"
      }
    },
    "sooli": {
      "$ref": "#/$defs/sooliResult"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ruleset_id": {
            "const": "project_target_v1"
          }
        },
        "required": [
          "ruleset_id"
        ]
      },
      "then": {
        "not": {
          "required": [
            "sooli"
          ]
        }
      },
      "else": {
        "required": [
          "sooli"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "SOOLI_WON",
              "SOOLI_LOST"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "contract": {
            "const": "RAMI"
          },
          "tricks": {
            "items": {
              "properties": {
                "plays": {
                  "maxItems": 3
                }
              }
            }
          },
          "deal_score": {
            "properties": {
              "points": {
                "const": 24
              },
              "stolen_rami": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "tricks": {
            "minItems": 13,
            "items": {
              "properties": {
                "plays": {
                  "minItems": 4
                }
              }
            }
          },
          "outcome": {
            "enum": [
              "NOLO",
              "MADE_RAMI",
              "STOLEN_RAMI"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "const": "NOLO"
          }
        },
        "required": [
          "contract"
        ]
      },
      "then": {
        "properties": {
          "declarer": {
            "type": "null"
          },
          "outcome": {
            "const": "NOLO"
          },
          "show_actions": {
            "minItems": 4,
            "maxItems": 4
          },
          "deal_score": {
            "properties": {
              "declaring_team": {
                "type": "null"
              },
              "stolen_rami": {
                "const": false
              },
              "points": {
                "minimum": 4,
                "maximum": 28,
                "multipleOf": 4
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "MADE_RAMI"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "deal_score": {
            "properties": {
              "stolen_rami": {
                "const": false
              },
              "points": {
                "minimum": 4,
                "maximum": 28,
                "multipleOf": 4
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "STOLEN_RAMI"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "deal_score": {
            "properties": {
              "stolen_rami": {
                "const": true
              },
              "points": {
                "minimum": 8,
                "maximum": 56,
                "multipleOf": 8
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "match_terminal": {
            "const": true
          }
        },
        "required": [
          "match_terminal"
        ]
      },
      "then": {
        "properties": {
          "score_after": {
            "$ref": "#/$defs/terminalScore"
          },
          "next_dealer": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "score_after": {
            "$ref": "#/$defs/nonterminalScore"
          },
          "next_dealer": {
            "$ref": "#/$defs/seat"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "const": "RAMI"
          }
        },
        "required": [
          "contract"
        ]
      },
      "then": {
        "properties": {
          "declarer": {
            "$ref": "#/$defs/seat"
          },
          "outcome": {
            "enum": [
              "MADE_RAMI",
              "STOLEN_RAMI",
              "SOOLI_WON",
              "SOOLI_LOST"
            ]
          },
          "deal_score": {
            "properties": {
              "declaring_team": {
                "$ref": "#/$defs/team"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "seat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "team": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "matchRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "dealRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}/deal:(?:0|[1-9][0-9]*)$",
      "maxLength": 128
    },
    "card": {
      "type": "string",
      "pattern": "^(?:[2-9]|10|J|Q|K|A)[HDCS]$"
    },
    "score": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "nonterminalScore": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 51
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 51
            },
            {
              "const": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "terminalScore": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 52
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 52
            },
            {
              "const": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "teamTricks": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "playedCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seat",
        "card"
      ],
      "properties": {
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "card": {
          "$ref": "#/$defs/card"
        }
      }
    },
    "acceptedShow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seat",
        "shown_card",
        "declared_contract",
        "verbal_required"
      ],
      "properties": {
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "shown_card": {
          "$ref": "#/$defs/card"
        },
        "declared_contract": {
          "enum": [
            "RAMI",
            "NOLO"
          ]
        },
        "verbal_required": {
          "type": "boolean"
        }
      }
    },
    "completedTrick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trick_index",
        "leader",
        "plays",
        "winner"
      ],
      "properties": {
        "trick_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "leader": {
          "$ref": "#/$defs/seat"
        },
        "plays": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/playedCard"
          }
        },
        "winner": {
          "$ref": "#/$defs/seat"
        }
      }
    },
    "dealScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaring_team",
        "points",
        "stolen_rami",
        "winner_team"
      ],
      "properties": {
        "declaring_team": {
          "oneOf": [
            {
              "$ref": "#/$defs/team"
            },
            {
              "type": "null"
            }
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 4,
          "maximum": 56,
          "multipleOf": 4
        },
        "stolen_rami": {
          "type": "boolean"
        },
        "winner_team": {
          "$ref": "#/$defs/team"
        }
      }
    },
    "sooliResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisions",
        "soolaaja",
        "partner",
        "soolaaja_won_trick"
      ],
      "properties": {
        "decisions": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seat",
              "play_sooli"
            ],
            "properties": {
              "seat": {
                "$ref": "#/$defs/seat"
              },
              "play_sooli": {
                "type": "boolean"
              }
            }
          }
        },
        "soolaaja": {
          "oneOf": [
            {
              "$ref": "#/$defs/seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "partner": {
          "oneOf": [
            {
              "$ref": "#/$defs/seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "soolaaja_won_trick": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$comment": "Executable result validation enforces forehand/leader relations, show order, all 52 distinct plays, trick indices and winners, team-trick sum 13, score formulas, score transition, event identity/index/order, event_log_id, and next-dealer rotation."
}
