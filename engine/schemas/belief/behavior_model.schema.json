{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tuppi.belief.behavior_model.schema.v1",
  "title": "Observation-safe behavioral action-likelihood model",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_id", "schema_version"],
  "properties": {
    "model_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "tuppi.belief.behavior_model.v1"},
    "profile_key": {"type": "string", "minLength": 1},
    "epsilon": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "components": {"type": "array", "items": {"type": "object"}},
    "weights": {"type": "array", "items": {"type": "number", "minimum": 0}}
  }
}
