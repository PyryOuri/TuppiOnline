{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuppi.research/schemas/exact/late_game_solution.schema.json",
  "title": "Exact late-game solution",
  "description": "The exact perfect-information optimum for one trick-play position. is_exact is const true: a position outside the budget raises instead of producing this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acting_seat",
    "actions",
    "algorithm_id",
    "contract",
    "declarer",
    "is_exact",
    "nodes_visited",
    "optimal_cards",
    "optimal_own_team_tricks_final",
    "optimal_team0_tricks_final",
    "own_team_prefers_more_tricks",
    "schema_version",
    "team0_tricks_so_far",
    "transposition_hits",
    "tricks_remaining"
  ],
  "properties": {
    "schema_version": {"const": "tuppi.exact.late_game_solution.v1"},
    "algorithm_id": {"const": "tuppi.exact.trick_count_minimax_v1"},
    "is_exact": {"const": true},
    "acting_seat": {"$ref": "#/$defs/seat"},
    "contract": {"enum": ["NOLO", "RAMI"]},
    "declarer": {"oneOf": [{"$ref": "#/$defs/seat"}, {"type": "null"}]},
    "tricks_remaining": {"type": "integer", "minimum": 1, "maximum": 13},
    "team0_tricks_so_far": {"$ref": "#/$defs/tricks"},
    "optimal_team0_tricks_final": {"$ref": "#/$defs/tricks"},
    "optimal_own_team_tricks_final": {"$ref": "#/$defs/tricks"},
    "own_team_prefers_more_tricks": {"type": "boolean"},
    "optimal_cards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/card"}
    },
    "nodes_visited": {"type": "integer", "minimum": 1},
    "transposition_hits": {"type": "integer", "minimum": 0},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card",
          "deal_points",
          "deal_winner_team",
          "equivalent_cards",
          "match_score_after",
          "match_terminal",
          "match_utility",
          "own_team_tricks_final",
          "own_team_wins_deal",
          "team0_tricks_final"
        ],
        "properties": {
          "card": {"$ref": "#/$defs/card"},
          "deal_points": {"type": "integer", "minimum": 4, "maximum": 56},
          "deal_winner_team": {"enum": [0, 1]},
          "equivalent_cards": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/card"}
          },
          "match_score_after": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 0}
          },
          "match_terminal": {"type": "boolean"},
          "match_utility": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer"}
          },
          "own_team_tricks_final": {"$ref": "#/$defs/tricks"},
          "own_team_wins_deal": {"type": "boolean"},
          "team0_tricks_final": {"$ref": "#/$defs/tricks"}
        }
      }
    }
  },
  "$defs": {
    "seat": {"type": "integer", "minimum": 0, "maximum": 3},
    "tricks": {"type": "integer", "minimum": 0, "maximum": 13},
    "card": {"type": "string", "pattern": "^(?:[2-9]|10|J|Q|K|A)[HDCS]$"}
  }
}
