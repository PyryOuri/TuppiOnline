{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tuppi/schemas/network/websocket_message.schema.json",
  "title": "Tuppi network v1 WebSocket messages",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/helloAcknowledgement"
    },
    {
      "$ref": "#/$defs/compatibilityResult"
    },
    {
      "$ref": "#/$defs/lobbySnapshot"
    },
    {
      "$ref": "#/$defs/ready"
    },
    {
      "$ref": "#/$defs/matchUpdate"
    },
    {
      "$ref": "#/$defs/actionSubmission"
    },
    {
      "$ref": "#/$defs/actionAcknowledgement"
    },
    {
      "$ref": "#/$defs/reconnect"
    },
    {
      "$ref": "#/$defs/reconnectResult"
    },
    {
      "$ref": "#/$defs/protocolError"
    },
    {
      "$ref": "#/$defs/ping"
    },
    {
      "$ref": "#/$defs/pong"
    },
    {
      "$ref": "#/$defs/hostCommandPause"
    },
    {
      "$ref": "#/$defs/hostCommandResume"
    },
    {
      "$ref": "#/$defs/hostCommandRematch"
    },
    {
      "$ref": "#/$defs/clientOptions"
    },
    {
      "$ref": "#/$defs/concede"
    },
    {
      "$ref": "#/$defs/seatBot"
    },
    {
      "$ref": "#/$defs/seatUpdate"
    },
    {
      "$ref": "#/$defs/chatSend"
    },
    {
      "$ref": "#/$defs/chatMessage"
    },
    {
      "$ref": "#/$defs/chatHistory"
    },
    {
      "$ref": "#/$defs/chatRefused"
    }
  ],
  "$defs": {
    "eventIndex": {
      "type": "integer",
      "minimum": -1
    },
    "roomCode": {
      "type": "string",
      "pattern": "^[A-Z0-9]{6}$"
    },
    "sessionToken": {
      "type": "string",
      "minLength": 20,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "helloPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "room_code",
        "session_token"
      ],
      "properties": {
        "protocol_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "room_code": {
          "$ref": "#/$defs/roomCode"
        },
        "session_token": {
          "$ref": "#/$defs/sessionToken"
        }
      }
    },
    "helloAcknowledgementPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible",
        "protocol_version",
        "room_code",
        "seat"
      ],
      "properties": {
        "compatible": {
          "const": true
        },
        "protocol_version": {
          "const": "tuppi.network.v1"
        },
        "room_code": {
          "$ref": "#/$defs/roomCode"
        },
        "seat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "pause",
              "rematch",
              "leaderboard",
              "compact_results",
              "rename",
              "release_seat",
              "concede",
              "results",
              "seat_bot",
              "seat_choice",
              "seat_swap",
              "leave_seat",
              "chat",
              "watch",
              "match_records",
              "deal_records"
            ]
          },
          "$comment": "Optional commands this server accepts; absent on servers without them."
        },
        "watching": {
          "const": true,
          "$comment": "A spectator's connection (feature watch)."
        }
      }
    },
    "compatibilityResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible",
        "supported_protocol_versions",
        "message_key"
      ],
      "properties": {
        "compatible": {
          "const": false
        },
        "supported_protocol_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": "tuppi.network.v1"
          }
        },
        "message_key": {
          "const": "update_required"
        }
      }
    },
    "readyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_token"
      ],
      "properties": {
        "session_token": {
          "$ref": "#/$defs/sessionToken"
        }
      }
    },
    "reconnectPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_applied_event_index"
      ],
      "properties": {
        "last_applied_event_index": {
          "$ref": "#/$defs/eventIndex"
        }
      }
    },
    "actionSubmissionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "client_action_id",
        "expected_event_index",
        "match_ref"
      ],
      "properties": {
        "action": {
          "oneOf": [
            {
              "$ref": "https://example.invalid/tuppi/schemas/engine/agent_script.schema.json#/$defs/action"
            },
            {
              "$ref": "https://example.invalid/tuppi/schemas/engine/player_observation.schema.json#/$defs/sooliDecisionAction"
            },
            {
              "$ref": "https://example.invalid/tuppi/schemas/engine/player_observation.schema.json#/$defs/sooliExchangeAction"
            }
          ]
        },
        "client_action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_event_index": {
          "$ref": "#/$defs/eventIndex"
        },
        "match_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        }
      }
    },
    "matchUpdatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_deals",
        "event_batch",
        "last_event_index",
        "match_ref",
        "observation"
      ],
      "properties": {
        "completed_deals": {
          "type": "array",
          "items": {
            "$ref": "https://example.invalid/tuppi/schemas/engine/deal_result.schema.json"
          }
        },
        "event_batch": {
          "type": "array",
          "items": {
            "$ref": "https://example.invalid/tuppi/schemas/engine/public_event_log.schema.json#/$defs/event"
          }
        },
        "last_event_index": {
          "$ref": "#/$defs/eventIndex"
        },
        "match_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "observation": {
          "$ref": "https://example.invalid/tuppi/schemas/engine/player_observation.schema.json"
        },
        "match_result": {
          "oneOf": [
            {
              "$ref": "https://example.invalid/tuppi/schemas/engine/match_result.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "bidding": {
          "$ref": "#/$defs/biddingPayload"
        },
        "conceded_deals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/concededDeal"
          }
        },
        "table": {
          "$ref": "#/$defs/tableView"
        }
      }
    },
    "reconnectResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_deals",
        "event_delta",
        "observation",
        "status"
      ],
      "properties": {
        "completed_deals": {
          "type": "array",
          "items": {
            "$ref": "https://example.invalid/tuppi/schemas/engine/deal_result.schema.json"
          }
        },
        "event_delta": {
          "type": "array",
          "items": {
            "$ref": "https://example.invalid/tuppi/schemas/engine/public_event_log.schema.json#/$defs/event"
          }
        },
        "observation": {
          "$ref": "https://example.invalid/tuppi/schemas/engine/player_observation.schema.json"
        },
        "status": {
          "const": "connected"
        },
        "match_result": {
          "oneOf": [
            {
              "$ref": "https://example.invalid/tuppi/schemas/engine/match_result.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "bidding": {
          "$ref": "#/$defs/biddingPayload"
        },
        "conceded_deals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/concededDeal"
          }
        },
        "table": {
          "$ref": "#/$defs/tableView"
        }
      }
    },
    "protocolErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "hello"
        },
        "payload": {
          "$ref": "#/$defs/helloPayload"
        }
      }
    },
    "helloAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "hello_ack"
        },
        "payload": {
          "$ref": "#/$defs/helloAcknowledgementPayload"
        }
      }
    },
    "compatibilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "compatibility_result"
        },
        "payload": {
          "$ref": "#/$defs/compatibilityResultPayload"
        }
      }
    },
    "lobbySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "lobby_snapshot"
        },
        "payload": {
          "$ref": "https://example.invalid/tuppi/schemas/network/http_api.schema.json#/$defs/lobbySnapshot"
        }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "ready"
        },
        "payload": {
          "$ref": "#/$defs/readyPayload"
        }
      }
    },
    "matchUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "match_update"
        },
        "payload": {
          "$ref": "#/$defs/matchUpdatePayload"
        }
      }
    },
    "actionSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "action_submission"
        },
        "payload": {
          "$ref": "#/$defs/actionSubmissionPayload"
        }
      }
    },
    "actionAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "action_acknowledgement"
        },
        "payload": {
          "$ref": "https://example.invalid/tuppi/schemas/network/action_acknowledgement.schema.json"
        }
      }
    },
    "reconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "reconnect"
        },
        "payload": {
          "$ref": "#/$defs/reconnectPayload"
        }
      }
    },
    "reconnectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "reconnect_result"
        },
        "payload": {
          "$ref": "#/$defs/reconnectResultPayload"
        }
      }
    },
    "protocolError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "protocol_error"
        },
        "payload": {
          "$ref": "#/$defs/protocolErrorPayload"
        }
      }
    },
    "ping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "ping"
        },
        "payload": {
          "$ref": "#/$defs/emptyPayload"
        }
      }
    },
    "pong": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "pong"
        },
        "payload": {
          "$ref": "#/$defs/emptyPayload"
        }
      }
    },
    "biddingPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "locked_seats",
        "own_bid",
        "options"
      ],
      "properties": {
        "schema_version": {
          "const": "tuppi.network.bidding.v1"
        },
        "locked_seats": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "own_bid": {
          "oneOf": [
            {
              "$ref": "https://example.invalid/tuppi/schemas/engine/player_observation.schema.json#/$defs/showAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "https://example.invalid/tuppi/schemas/engine/player_observation.schema.json#/$defs/showAction"
          }
        }
      },
      "$comment": "project_target_v3 only, while bids are locked: which seats have locked, this seat's own bid and, until it locks, its options. Never another seat's bid."
    },
    "hostCommandPause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "pause"
        },
        "payload": {
          "$ref": "#/$defs/emptyPayload"
        }
      },
      "$comment": "Host only. Pause/resume while a match is in progress; rematch after it is complete."
    },
    "hostCommandResume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "resume"
        },
        "payload": {
          "$ref": "#/$defs/emptyPayload"
        }
      },
      "$comment": "Host only. Pause/resume while a match is in progress; rematch after it is complete."
    },
    "hostCommandRematch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "rematch"
        },
        "payload": {
          "$ref": "#/$defs/emptyPayload"
        }
      },
      "$comment": "Host only. Pause/resume while a match is in progress; rematch after it is complete."
    },
    "clientOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "client_options"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "omit_match_result": {
              "type": "boolean"
            },
            "seat_updates": {
              "type": "boolean",
              "$comment": "The app takes a new seat from seat_update (send only to servers listing seat_swap)."
            }
          },
          "minProperties": 1
        }
      },
      "$comment": "Sent only to servers listing compact_results. omit_match_result drops match_result from this connection's match_update and reconnect_result."
    },
    "concededDeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_tricks",
        "deal_number",
        "seat"
      ],
      "properties": {
        "after_tricks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        "deal_number": {
          "type": "integer",
          "minimum": 0
        },
        "seat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "$comment": "A deal finished by concession (feature concede): who conceded and after how many tricks. Its remaining cards were played automatically; the result was already 0-0."
    },
    "concede": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "concede"
        },
        "payload": {
          "$ref": "#/$defs/emptyPayload"
        }
      },
      "$comment": "Any human seat (feature concede): finish a deal whose result is already 0-0. Ignored (answered with a match_update) when not available."
    },
    "seatBot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "seat_bot"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seat",
            "bot"
          ],
          "properties": {
            "seat": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "bot": {
              "type": "boolean"
            }
          }
        }
      },
      "$comment": "During a match (feature seat_bot): the host lets a bot play for a player who is not connected (bot true); that player or the host takes the seat back (bot false). A refusal is answered with a lobby_snapshot."
    },
    "seatUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "seat_update"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seat"
          ],
          "properties": {
            "seat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        }
      },
      "$comment": "Server to a player the host moved before a match (feature seat_swap): their new seat. Seat 0 only when another player hosts (feature leave_seat)."
    },
    "chatItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "id",
        "seat",
        "sent_at",
        "text"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "seat": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3,
          "$comment": "null: a spectator (feature watch)."
        },
        "sent_at": {
          "type": "integer",
          "minimum": 0,
          "$comment": "Server time, seconds since 1970."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "chatSend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "chat_send"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 2000
            }
          }
        }
      },
      "$comment": "Client to server (feature chat): a message to everyone in the room. The server keeps one line of at most 200 characters."
    },
    "chatMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "chat_message"
        },
        "payload": {
          "$ref": "#/$defs/chatItem"
        }
      },
      "$comment": "Server to everyone in the room (feature chat). Chat is kept in server memory only, never saved or logged."
    },
    "chatHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "chat_history"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "messages"
          ],
          "properties": {
            "messages": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "$ref": "#/$defs/chatItem"
              }
            }
          }
        }
      },
      "$comment": "Server to a connection after hello_ack (feature chat): the room's latest messages, oldest first. Replaces what the app shows."
    },
    "chatRefused": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "payload"
      ],
      "properties": {
        "message_type": {
          "const": "chat_refused"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_chat",
                "chat_rate_limited"
              ]
            }
          }
        }
      },
      "$comment": "Server to the sender only (feature chat): the message was not sent. Not a protocol error; the connection stays."
    },
    "tableView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hands",
        "schema_version"
      ],
      "properties": {
        "hands": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "maxItems": 14,
            "items": {
              "type": "string",
              "pattern": "^(10|[2-9JQKA])[HDCS]$"
            }
          }
        },
        "schema_version": {
          "const": "tuppi.network.table_view.v1"
        }
      },
      "$comment": "Spectators only (feature watch): every seat's cards now, by seat. Their observation is seat 0's public table with no hand or actions."
    }
  }
}
