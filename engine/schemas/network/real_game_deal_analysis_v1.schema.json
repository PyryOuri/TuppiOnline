{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tuppi/schemas/network/real_game_deal_analysis_v1.schema.json",
  "title": "Completed-deal analysis for the real game (project_target_v2/v3)",
  "description": "POST /v1/rooms/{code}/deals/{n}/analysis in a sooli or locked-bid room. Post-deal only: the four dealt hands, both exchanged cards of a sooli deal, a same-cards replay by the room's own bots on all four seats (locked bids, sooli when one calls it) with its action transcript, the comparison with the deal as played, and the requesting seat's after-deal review (null when the server has no reviewer). analyses is always empty: the review takes the place of the basic-rules diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "match_ref", "deal_ref", "deal_number", "seat", "ruleset_id", "deal_id",
    "local_team", "initial_hands", "actual_result", "actual_exchange", "bot_policy", "bot_replay",
    "bot_exchange", "bot_actions", "comparison", "summary", "analyses", "review"
  ],
  "properties": {
    "schema_version": {"const": "tuppi.analysis.real_game_deal.v1"},
    "match_ref": {"$ref": "https://example.invalid/tuppi/schemas/network/completed_deal_analysis_v3.schema.json#/properties/match_ref"},
    "deal_ref": {"$ref": "https://example.invalid/tuppi/schemas/network/completed_deal_analysis_v3.schema.json#/properties/deal_ref"},
    "deal_number": {"type": "integer", "minimum": 0},
    "seat": {"type": "integer", "minimum": 0, "maximum": 3},
    "ruleset_id": {"enum": ["project_target_v2", "project_target_v3"]},
    "deal_id": {"$ref": "https://example.invalid/tuppi/schemas/network/completed_deal_analysis_v3.schema.json#/properties/deal_id"},
    "local_team": {"$ref": "https://example.invalid/tuppi/schemas/network/completed_deal_analysis_v3.schema.json#/properties/local_team"},
    "initial_hands": {"$ref": "https://example.invalid/tuppi/schemas/network/completed_deal_analysis_v3.schema.json#/properties/initial_hands"},
    "actual_result": {"$ref": "https://example.invalid/tuppi/schemas/engine/deal_result.schema.json"},
    "actual_exchange": {"$ref": "#/$defs/exchange"},
    "bot_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "policy_id", "determinism", "analysis_seed", "bot_seats"],
      "properties": {
        "profile": {"type": "string", "minLength": 1, "maxLength": 64},
        "policy_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "determinism": {"const": "seeded"},
        "analysis_seed": {"type": "null"},
        "bot_seats": {"const": [0, 1, 2, 3]}
      }
    },
    "bot_replay": {"$ref": "https://example.invalid/tuppi/schemas/engine/deal_result.schema.json"},
    "bot_exchange": {"$ref": "#/$defs/exchange"},
    "bot_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {"$ref": "https://example.invalid/tuppi/schemas/engine/player_observation.schema.json#/$defs/action"}
    },
    "comparison": {"$ref": "https://example.invalid/tuppi/schemas/network/completed_deal_analysis_v3.schema.json#/properties/comparison"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "diagnostic_count", "outcome", "points", "score_before", "score_after", "team_tricks"],
      "properties": {
        "contract": {"enum": ["RAMI", "NOLO"]},
        "diagnostic_count": {"type": "integer", "minimum": 0},
        "outcome": {"enum": ["NOLO", "MADE_RAMI", "STOLEN_RAMI", "SOOLI_WON", "SOOLI_LOST"]},
        "points": {"type": "integer", "minimum": 0},
        "score_before": {"$ref": "#/$defs/scorePair"},
        "score_after": {"$ref": "#/$defs/scorePair"},
        "team_tricks": {"$ref": "#/$defs/scorePair"}
      }
    },
    "analyses": {"type": "array", "maxItems": 0},
    "review": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "https://example.invalid/tuppi/schemas/network/deal_review_v1.schema.json"}
      ]
    }
  },
  "$defs": {
    "card": {"type": "string", "pattern": "^(?:10|[2-9JQKA])[HDCS]$"},
    "exchange": {
      "description": "A sooli deal's private exchange, revealed after the deal: the soolaaja gave `given` to the partner, who returned `returned`. Null when no sooli was played.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["given", "returned"],
          "properties": {"given": {"$ref": "#/$defs/card"}, "returned": {"$ref": "#/$defs/card"}}
        }
      ]
    },
    "scorePair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 0}
    }
  }
}
