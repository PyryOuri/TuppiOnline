{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tuppi/schemas/network/http_api.schema.json",
  "title": "Tuppi private-alpha HTTP API payloads",
  "oneOf": [
    {
      "$ref": "#/$defs/compatibilityResult"
    },
    {
      "$ref": "#/$defs/createRoomRequest"
    },
    {
      "$ref": "#/$defs/joinRoomRequest"
    },
    {
      "$ref": "#/$defs/configureRoomRequest"
    },
    {
      "$ref": "#/$defs/roomSettingsRequest"
    },
    {
      "$ref": "#/$defs/renameRequest"
    },
    {
      "$ref": "#/$defs/releaseSeatRequest"
    },
    {
      "$ref": "#/$defs/sessionRequest"
    },
    {
      "$ref": "#/$defs/roomBootstrap"
    },
    {
      "$ref": "#/$defs/roomStatusResponse"
    },
    {
      "$ref": "#/$defs/serverError"
    },
    {
      "$ref": "https://example.invalid/tuppi/schemas/network/post_match_analysis.schema.json"
    },
    {
      "$ref": "https://example.invalid/tuppi/schemas/network/completed_deal_analysis.schema.json"
    },
    {
      "$ref": "https://example.invalid/tuppi/schemas/network/training_analysis.schema.json"
    },
    {
      "$ref": "#/$defs/offlineResultRequest"
    },
    {
      "$ref": "#/$defs/seatPreview"
    },
    {
      "$ref": "#/$defs/swapSeatsRequest"
    },
    {
      "$ref": "#/$defs/leaveResponse"
    },
    {
      "$ref": "#/$defs/watchRequest"
    },
    {
      "$ref": "#/$defs/watchBootstrap"
    },
    {
      "$ref": "#/$defs/offlineMatchRecordRequest"
    },
    {
      "$ref": "#/$defs/dealRecordsResponse"
    }
  ],
  "$defs": {
    "seat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "aiSeat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "$comment": "Never the host's seat (seat 0 unless the host left and another player hosts)."
    },
    "roomCode": {
      "type": "string",
      "pattern": "^[A-Z0-9]{6}$"
    },
    "sessionToken": {
      "type": "string",
      "minLength": 20,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "aiSeats": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/aiSeat"
      }
    },
    "lobbySeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "kind",
        "ready",
        "seat"
      ],
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "kind": {
          "enum": [
            "open",
            "human",
            "ai"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "agent_profile": {
          "enum": [
            "partner_aware_v1",
            "partner_aware_lead_v2",
            "tuppi_ai_search_v1",
            "tuppi_ai_lite_c1h_v1",
            "tuppi_ai_heidi10_pib8_v1"
          ]
        },
        "connected": {
          "type": "boolean",
          "$comment": "People's seats in WebSocket lobby updates: whether that player is connected now."
        },
        "covering": {
          "$ref": "#/$defs/displayName",
          "$comment": "A bot seat standing in for this player during a match (feature seat_bot)."
        },
        "joining": {
          "const": true,
          "$comment": "During a match (feature leave_seat): the covering player joined this seat and plays from the next deal; the bot finishes this one."
        },
        "vacant": {
          "const": true,
          "$comment": "During a match (feature leave_seat): its player left; a bot plays it and anyone may join it."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ai"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "agent_profile"
            ]
          },
          "else": {
            "not": {
              "required": [
                "agent_profile"
              ]
            }
          }
        }
      ]
    },
    "lobbySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai_action_delay_ms",
        "lifecycle",
        "room_code",
        "seats"
      ],
      "properties": {
        "ai_action_delay_ms": {
          "enum": [
            0,
            500,
            1000,
            1500,
            2000,
            2500,
            3000,
            4000,
            5000
          ]
        },
        "lifecycle": {
          "enum": [
            "created",
            "configured",
            "waiting",
            "ready",
            "playing",
            "completed"
          ]
        },
        "room_code": {
          "$ref": "#/$defs/roomCode"
        },
        "seats": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/lobbySeat"
          }
        },
        "ruleset_id": {
          "enum": [
            "project_target_v2",
            "project_target_v3"
          ],
          "$comment": "Absent for project_target_v1 rooms."
        },
        "paused": {
          "const": true,
          "$comment": "Present while the host has paused the match."
        },
        "match_number": {
          "type": "integer",
          "minimum": 2,
          "$comment": "Present after a rematch; the first match omits it."
        },
        "previous_matches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/previousMatch"
          },
          "$comment": "Results of this room's earlier matches, oldest first."
        },
        "host_seat": {
          "$ref": "#/$defs/seat",
          "$comment": "The host's seat: 0 unless the host left (feature leave_seat) and another player hosts."
        },
        "watchers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/displayName"
          },
          "$comment": "People watching now (feature watch), in arrival order; absent when nobody watches."
        },
        "bot_profile": {
          "enum": [
            "tuppi_ai_lite_c1h_v1",
            "tuppi_ai_heidi10_pib8_v1"
          ]
        }
      }
    },
    "compatibilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible",
        "protocol_version",
        "status"
      ],
      "properties": {
        "compatible": {
          "const": true
        },
        "protocol_version": {
          "const": "tuppi.network.v1"
        },
        "status": {
          "const": "ok"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "pause",
              "rematch",
              "leaderboard",
              "compact_results",
              "rename",
              "release_seat",
              "concede",
              "results",
              "seat_bot",
              "seat_choice",
              "seat_swap",
              "leave_seat",
              "chat",
              "watch",
              "match_records",
              "deal_records"
            ]
          },
          "$comment": "Optional commands this server accepts; absent on servers without them."
        },
        "create_passcode_required": {
          "type": "boolean",
          "$comment": "Hosted deployments: whether creating a room needs room_passcode. Joining never does."
        },
        "bot_options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "name"
            ],
            "properties": {
              "profile": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "max_active_tables": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "createRoomRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "ai_seats"
      ],
      "properties": {
        "display_name": {
          "$ref": "#/$defs/displayName"
        },
        "ai_seats": {
          "$ref": "#/$defs/aiSeats"
        },
        "room_passcode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "$comment": "Required by hosts that set a room-creation passcode (see compatibilityResult.create_passcode_required); removed before the room is created."
        },
        "bot_profile": {
          "enum": [
            "tuppi_ai_search_v1",
            "tuppi_ai_lite_c1h_v1",
            "tuppi_ai_heidi10_pib8_v1"
          ]
        }
      }
    },
    "joinRoomRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name"
      ],
      "properties": {
        "display_name": {
          "$ref": "#/$defs/displayName"
        },
        "seat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "$comment": "Optional (feature seat_choice): the free seat to take; else the lowest free seat. Seat 0 only when the host left and another player hosts, or during a match when its player left (feature leave_seat)."
        }
      }
    },
    "configureRoomRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_token",
        "ai_seats"
      ],
      "properties": {
        "session_token": {
          "$ref": "#/$defs/sessionToken"
        },
        "ai_seats": {
          "$ref": "#/$defs/aiSeats"
        }
      }
    },
    "roomSettingsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_token",
        "ai_action_delay_ms"
      ],
      "properties": {
        "session_token": {
          "$ref": "#/$defs/sessionToken"
        },
        "ai_action_delay_ms": {
          "enum": [
            0,
            500,
            1000,
            1500,
            2000,
            2500,
            3000,
            4000,
            5000
          ]
        }
      }
    },
    "sessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_token"
      ],
      "properties": {
        "session_token": {
          "$ref": "#/$defs/sessionToken"
        }
      }
    },
    "roomBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room_code",
        "seat",
        "session_token",
        "lobby"
      ],
      "properties": {
        "room_code": {
          "$ref": "#/$defs/roomCode"
        },
        "seat": {
          "$ref": "#/$defs/seat"
        },
        "session_token": {
          "$ref": "#/$defs/sessionToken"
        },
        "lobby": {
          "$ref": "#/$defs/lobbySnapshot"
        }
      }
    },
    "roomStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lobby"
      ],
      "properties": {
        "lobby": {
          "$ref": "#/$defs/lobbySnapshot"
        },
        "playing": {
          "type": "boolean"
        }
      }
    },
    "serverError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        }
      }
    },
    "previousMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deals",
        "final_score",
        "match_ref",
        "winner_team"
      ],
      "properties": {
        "deals": {
          "type": "integer",
          "minimum": 0
        },
        "final_score": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer"
          }
        },
        "match_ref": {
          "type": "string",
          "minLength": 1
        },
        "winner_team": {
          "enum": [
            0,
            1
          ]
        }
      }
    },
    "leaderboardResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "const": "tuppi.network.leaderboard.v1"
        },
        "entries": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "losses",
              "matches",
              "name",
              "win_percent",
              "wins"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "wins": {
                "type": "integer",
                "minimum": 0
              },
              "losses": {
                "type": "integer",
                "minimum": 0
              },
              "matches": {
                "type": "integer",
                "minimum": 0
              },
              "win_percent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      },
      "$comment": "Finished online matches on this server, per unverified nickname; human seats only. POST /v1/rooms/{code}/leaderboard with a sessionRequest."
    },
    "renameRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_token",
        "display_name"
      ],
      "properties": {
        "session_token": {
          "$ref": "#/$defs/sessionToken"
        },
        "display_name": {
          "$ref": "#/$defs/displayName"
        }
      },
      "$comment": "POST /v1/rooms/{code}/name: a player renames their own seat before the match starts (feature rename)."
    },
    "releaseSeatRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_token",
        "seat"
      ],
      "properties": {
        "session_token": {
          "$ref": "#/$defs/sessionToken"
        },
        "seat": {
          "$ref": "#/$defs/seat"
        }
      },
      "$comment": "POST /v1/rooms/{code}/release: the host frees another player's seat before the match starts (feature release_seat); that player's socket closes with code 4002."
    },
    "offlineResultRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conceded",
        "deals",
        "final_score",
        "id",
        "winner_team",
        "worlds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{16,64}$"
        },
        "worlds": {
          "enum": [
            128,
            1024
          ]
        },
        "winner_team": {
          "enum": [
            0,
            1
          ]
        },
        "final_score": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          }
        },
        "deals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "conceded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "bot": {
          "enum": [
            "heidi05",
            "heidi10"
          ]
        }
      },
      "$comment": "POST /v1/results (feature results): an anonymous finished offline match, from the person's team's view (team 0). No names, cards or hands."
    },
    "seatPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "joinable",
        "room_code",
        "seats"
      ],
      "properties": {
        "joinable": {
          "type": "boolean"
        },
        "room_code": {
          "$ref": "#/$defs/roomCode"
        },
        "seats": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "display_name",
              "kind",
              "seat"
            ],
            "properties": {
              "display_name": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 40
              },
              "kind": {
                "enum": [
                  "open",
                  "human",
                  "ai"
                ]
              },
              "seat": {
                "$ref": "#/$defs/seat"
              }
            }
          }
        },
        "host_seat": {
          "$ref": "#/$defs/seat"
        }
      },
      "$comment": "POST /v1/rooms/{code}/seats with {} (feature seat_choice): who sits where, to choose a seat before joining. The host's partner sits opposite host_seat. During a match (feature leave_seat) the seats players left are open and joinable."
    },
    "swapSeatsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_token",
        "seats"
      ],
      "properties": {
        "session_token": {
          "$ref": "#/$defs/sessionToken"
        },
        "seats": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      },
      "$comment": "POST /v1/rooms/{code}/swap (feature seat_swap): the host swaps two of the other seats before a match; moved players get a seat_update."
    },
    "leaveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed"
      ],
      "properties": {
        "closed": {
          "type": "boolean",
          "$comment": "The last player left: the room is closed."
        }
      },
      "$comment": "POST /v1/rooms/{code}/leave with {session_token} (feature leave_seat): the player leaves the room for good and the credential stops working. During a match a bot plays the seat and anyone may join it; the next player hosts if the host left."
    },
    "watchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name"
      ],
      "properties": {
        "display_name": {
          "$ref": "#/$defs/displayName"
        }
      },
      "$comment": "POST /v1/rooms/{code}/watch (feature watch): watch the room, before or during a match. At most 8 spectators; watchers_full otherwise."
    },
    "watchBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room_code",
        "seat",
        "session_token",
        "lobby",
        "watching"
      ],
      "properties": {
        "room_code": {
          "$ref": "#/$defs/roomCode"
        },
        "seat": {
          "const": 0,
          "$comment": "The table is shown from seat 0."
        },
        "session_token": {
          "$ref": "#/$defs/sessionToken"
        },
        "lobby": {
          "$ref": "#/$defs/lobbySnapshot"
        },
        "watching": {
          "const": true
        }
      },
      "$comment": "A spectator's credential (feature watch). It is kept in server memory only; after a restart the app asks to watch again. POST /leave with it stops watching."
    },
    "offlineMatchRecordRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deals",
        "id",
        "runtime",
        "worlds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{16,64}$"
        },
        "worlds": {
          "enum": [
            128,
            1024
          ]
        },
        "runtime": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "deals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actions",
              "cards",
              "dealer",
              "score"
            ],
            "properties": {
              "cards": {
                "type": "array",
                "minItems": 52,
                "maxItems": 52,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 51
                },
                "$comment": "Seat s holds cards[13s..13s+12]; a card is suit*13 + rank (suits H D C S, ranks 2..A)."
              },
              "dealer": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "score": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "actions": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 209
                },
                "$comment": "The browser's action numbers in the order applied."
              },
              "conceded": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "afterTricks"
                ],
                "properties": {
                  "afterTricks": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  }
                }
              }
            }
          }
        },
        "bot": {
          "enum": [
            "heidi05",
            "heidi10"
          ]
        }
      },
      "$comment": "POST /v1/research/matches (round 15): a browser's finished offline match with every card, sent under the research setting. Accepted only if it replays legally; answered {recorded}. GET /v1/research/matches?key=<TUPPI_RESEARCH_KEY> downloads every record (research_match_v1) as one gzip file of JSON lines."
    },
    "dealRecordsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_ref",
        "deals"
      ],
      "properties": {
        "match_ref": {
          "type": "string"
        },
        "deals": {
          "type": "array",
          "items": {
            "$ref": "https://example.invalid/tuppi/schemas/network/research_match_v1.schema.json#/properties/deals/items"
          }
        }
      },
      "$comment": "POST /v1/rooms/{code}/records with {session_token} (feature deal_records, round 16 viewer): the current match's finished deals in full (hands, every action with who made it), to a player or a spectator of the room. The deal in play is never included. Finished deals come first: deals[n] is deal n."
    }
  }
}
